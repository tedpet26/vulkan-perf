{
	"schemaVersion": 1,
	"id": "vulkanperf",
	"version": "${version}",
	"name": "vulkan-perf",
	"description": "26.3 Fabric performance suite for Blaze3D / Vulkan. Rewritten from public 26.2 mod references.",
	"authors": ["vulkan-perf"],
	"license": "LGPL-3.0-or-later",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.vulkanperf.VulkanPerf"],
		"client": ["dev.vulkanperf.client.VulkanPerfClient"],
		"sodium:config_api_user": ["dev.vulkanperf.client.extras.ExtrasSodiumConfig"]
	},
	"mixins": [
		"vulkanperf.mixins.json",
		{
			"config": "vulkanperf.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3-",
		"java": ">=25",
		"fabric-api": "*",
		"sodium": "*"
	},
	"breaks": {
		"lithium": "*",
		"c2me": "*",
		"sodium-extra": "*",
		"immediatelyfast": "*",
		"entityculling": "*",
		"moreculling": "*",
		"asyncparticles": "*",
		"particle_core": "*",
		"betterblockentities": "*",
		"badoptimizations": "*",
		"dynamic_fps": "*",
		"debugify": "*",
		"fastipping": "*",
		"gnetum": "*",
		"ixeris": "*",
		"logcleaner": "*",
		"packetfixer": "*",
		"rrls": "*",
		"cwb": "*",
		"ferritecore": "*",
		"krypton": "*",
		"modernfix": "*"
	}
}
